# Copy to infra/.env and replace every value. Compose reads .env from the
# directory holding the compose file, so it belongs here rather than at the root.
#
#   cp infra/.env.example infra/.env
#
# .env is gitignored. These are the only secrets the stack has: there is no
# secret manager in front of them, they are visible in `docker inspect`, and
# they reach each process as plain environment variables.

# Generate each of these, do not invent them by hand:
#   openssl rand -hex 32

# Grants full administrative access to every tenant over HTTP. Compromising this
# is equivalent to compromising the platform.
ADMIN_TOKEN=replace-me

# Shared between the control plane and the data plane. The data plane accepts
# ruleset publishes only when it matches, and disables the endpoint entirely
# when it is unset, so both services must be given the same value.
PUBLISH_TOKEN=replace-me

POSTGRES_PASSWORD=replace-me
CLICKHOUSE_PASSWORD=replace-me
